{
    "name": "alex-kassel/stable-fingerprint",
    "description": "Deterministic SHA-256 canonicalization and payload hashing for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "fingerprint",
        "hashing",
        "canonicalization",
        "sha256",
        "json-canonicalization",
        "deterministic-hash",
        "payload-hashing"
    ],
    "homepage": "https://github.com/alex-kassel/stable-fingerprint",
    "support": {
        "issues": "https://github.com/alex-kassel/stable-fingerprint/issues",
        "source": "https://github.com/alex-kassel/stable-fingerprint"
    },
    "authors": [
        {
            "name": "Alexander Macenko",
            "email": "alexander.macenko@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-hash": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AlexKassel\\StableFingerprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKassel\\StableFingerprint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
